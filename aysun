


/* TAB NAVIGATION - NOT STICKY */
.services-tabs-wrapper {
  background: var(--card-bg);
  border-bottom: 2px solid var(--gold);
  padding: 1.5rem 0 1rem;
  position: relative;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}
.tabs-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
}
.tabs-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 12px;
}
.tabs-row.bottom-row {
  margin-top: 10px;
  margin-bottom: 0;
}
.tab-btn {
  padding: 12px 8px;
  border-radius: 10px;
  border: 1.5px solid var(--border);
  background: var(--card-bg);
  color: var(--text);
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
  white-space: normal;
  word-wrap: break-word;
  font-family: inherit;
  flex: 1 1 0;
  min-width: 0;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
}
.tab-btn:hover {
  border-color: var(--gold);
  color: var(--gold);
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}
.tab-btn.active {
  background: var(--gold);
  color: #fff;
  border-color: var(--gold);
  box-shadow: 0 4px 16px rgba(200,146,42,0.3);
  font-weight: 700;
}

/* MAIN CONTENT */
.service-content-area {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem 2rem 4rem;
}
.service-panel {
  display: none;
}
.service-panel.active {
  display: block;
  animation: fadeIn 0.4s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* SERVICE HEADER - SIMPLE */
.service-header {
  margin-bottom: 1.5rem;
  text-align: center;
}
.service-header h2 {
  font-size: 1.75rem;
  font-weight: 800;
  color: var(--heading);
  margin-bottom: 0.75rem;
  letter-spacing: -0.02em;
}
.service-header h2 em {
  color: var(--gold);
  font-style: normal;
}
.service-header p {
  color: var(--text-muted);
  font-size: 1rem;
  line-height: 1.6;
  max-width: 800px;
  margin: 0 auto;
}

/* TABLE STYLES - NO HORIZONTAL SCROLL */
.service-table-container {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  margin-bottom: 1.5rem;
}
.service-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}
.service-table thead {
  background: var(--gold-bg);
}
.service-table th {
  padding: 1rem 1.25rem;
  text-align: left;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--gold);
  border-bottom: 2px solid var(--gold);
}
.service-table th:nth-child(1) { width: 28%; }
.service-table th:nth-child(2) { width: 42%; }
.service-table th:nth-child(3) { width: 15%; text-align: center; }
.service-table th:nth-child(4) { width: 15%; text-align: center; }

.service-table td {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border);
  font-size: 0.9rem;
  color: var(--text);
  vertical-align: top;
  word-wrap: break-word;
  overflow-wrap: break-word;
}
.service-table td:nth-child(3),
.service-table td:nth-child(4) {
  text-align: center;
  font-weight: 600;
}
.service-table td:nth-child(3) {
  color: var(--gold);
}
.service-table tbody tr:hover {
  background: var(--gold-pale);
}
.service-table tbody tr:last-child td {
  border-bottom: none;
}
.service-table .col-service {
  font-weight: 600;
  color: var(--heading);
}
.service-table .col-desc {
  line-height: 1.6;
  font-size: 0.88rem;
}

/* SUB-SECTION HEADER IN TABLE */
.subsection-header {
  background: var(--gold-pale) !important;
}
.subsection-header td {
  font-weight: 700;
  color: var(--gold) !important;
  font-size: 0.85rem;
  letter-spacing: 0.02em;
  border-bottom: 2px solid var(--gold-border) !important;
}

/* TIMELINE - BELOW TABLE */
.timeline-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 2rem;
  box-shadow: var(--shadow-sm);
  margin-bottom: 1.5rem;
}
.timeline-header {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--gold);
  margin-bottom: 1.5rem;
  text-align: center;
  letter-spacing: 0.02em;
}
.timeline-track {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  position: relative;
}
.timeline-track::before {
  content: '';
  position: absolute;
  top: 16px;
  bottom: 16px;
  left: 15px;
  width: 2px;
  background: var(--border);
}
.timeline-step {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  position: relative;
  z-index: 1;
}
.timeline-dot {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--card-bg);
  border: 2px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.85rem;
  color: var(--text-muted);
  flex-shrink: 0;
}
.timeline-step.active .timeline-dot,
.timeline-step.completed .timeline-dot {
  background: var(--gold);
  border-color: var(--gold);
  color: #fff;
}
.timeline-step.active .timeline-dot {
  box-shadow: 0 0 0 4px rgba(200,146,42,0.18);
}
.timeline-info h4 {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 3px;
}
.timeline-info p {
  font-size: 0.85rem;
  color: var(--text-muted);
  line-height: 1.5;
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .service-table th:nth-child(1) { width: 30%; }
  .service-table th:nth-child(2) { width: 40%; }
  .service-table th:nth-child(3) { width: 15%; }
  .service-table th:nth-child(4) { width: 15%; }
}
@media (max-width: 768px) {
  .tabs-container { padding: 0 1rem; }
  .tabs-row {
    gap: 8px;
  }
  .tab-btn {
    flex-shrink: 0;
    min-width: 130px;
    padding: 10px 12px;
    font-size: 0.78rem;
    border-radius: 8px;
    white-space: normal;
  }
  .service-content-area { padding: 1.5rem 1rem 3rem; }
  .service-header h2 { font-size: 1.4rem; }
  .service-table th,
  .service-table td {
    padding: 0.75rem;
    font-size: 0.8rem;
  }
  .service-table th:nth-child(1) { width: 32%; }
  .service-table th:nth-child(2) { width: 38%; }
  .service-table th:nth-child(3) { width: 15%; }
  .service-table th:nth-child(4) { width: 15%; }
  .timeline-card { padding: 1.5rem 1.25rem; }
}
@media (max-width: 480px) {
  .tab-btn { min-width: 110px; padding: 8px 10px; font-size: 0.72rem; }
  .service-header h2 { font-size: 1.2rem; }
  .service-table th,
  .service-table td {
    padding: 0.6rem;
    font-size: 0.75rem;
  }
}
@media (prefers-reduced-motion: reduce) {
  * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}














